# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
/.quarto/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds

# Survey microdata — raw files are sensitive / proprietary
Data/raw/*
!Data/raw/.gitkeep

# Data intermediates
Data/cleaned/*
!Data/cleaned/.gitkeep
Data/codebooks/*
!Data/codebooks/.gitkeep

# R intermediate outputs (logs, objects, CSVs from analysis runs)
prism/tables/*.rds
prism/tables/*.txt
prism/tables/*.csv
Output/

# R workspace / temp
scripts/R/.RDataTmp
*.RDataTmp

# LaTeX test artifacts
prism/manuscript_test.*
prism/manuscript.bcf

# Sanity-check figures (not for publication)
prism/figures/fig_sanity_*.pdf
