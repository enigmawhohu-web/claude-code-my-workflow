	keywords = {bonferroni-type procedures, familywise error rate, multiple-comparison procedures, p-values},
	pages = {289--300},
	file = {PDF:/Users/chrishu/Zotero/storage/UGFR45R8/Benjamini和Hochberg - 1995 - Controlling the False Discovery Rate A Practical and Powerful Approach to Multiple Testing.pdf:application/pdf;Snapshot:/Users/chrishu/Zotero/storage/V5KV484P/j.2517-6161.1995.tb02031.html:text/html},
